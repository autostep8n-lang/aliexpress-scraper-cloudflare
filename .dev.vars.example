# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# Never commit the real `.dev.vars` file.
#
# These match the secret names declared in `wrangler.toml` under `[secrets]`.
# For the deployed Worker, set them via:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_SECRET_KEY

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<your-secret-key>

# Optional: official AliExpress Open Platform (open.aliexpress.com) app
# credentials. When set, the AliExpress scraper prefers the official
# `aliexpress.ds.product.get` API. Without them it falls back to the internal
# mtop gateway, which needs no API key.
# ALIEXPRESS_OPENAPI_KEY=<your-app-key>
# ALIEXPRESS_OPENAPI_SECRET=<your-app-secret>

# Optional (non-secret): Google Trends provider selector. The default
# "internal-api" provider talks to Google's undocumented internal endpoints and
# needs no credentials. Leave unset for the default.
# GOOGLE_TRENDS_PROVIDER=internal-api

# Optional: Reddit OAuth2 app-only credentials (create a "script" app at
# https://www.reddit.com/prefs/apps). When set, the Reddit market-intelligence
# module collects via the official oauth.reddit.com API. Without them it
# degrades with a typed REDDIT_NOT_CONFIGURED error.
# REDDIT_CLIENT_ID=<your-app-client-id>
# REDDIT_CLIENT_SECRET=<your-app-client-secret>
# REDDIT_USER_AGENT=my-product-intelligence/0.1 (Cloudflare Worker collector)

# Optional: YouTube Data API v3 key (Google Cloud Console > APIs & Services,
# enable "YouTube Data API v3", create an API key). When set, the YouTube
# market-intelligence module collects via the official www.googleapis.com API.
# Without it the module degrades with a typed YOUTUBE_NOT_CONFIGURED error.
# YOUTUBE_API_KEY=<your-google-api-key>

# Optional: Instagram Graph API access token (long-lived app-user token for an
# Instagram Business/Creator account) plus that account's IG User id. When set,
# the Instagram market-intelligence module collects hashtag media via the
# official graph.facebook.com API. Without them it degrades with a typed
# INSTAGRAM_NOT_CONFIGURED error.
# INSTAGRAM_ACCESS_TOKEN=<your-long-lived-app-user-token>
# INSTAGRAM_IG_USER_ID=<your-ig-business-account-id>
